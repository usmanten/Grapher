{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usmanten/grapher/schema/graph.schema.json",
  "title": "Grapher graph",
  "description": "How a project's files, databases, outside services and settings connect. Version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "nodes", "connections", "unknownPackages", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "framework"],
      "properties": {
        "name": { "type": "string" },
        "framework": { "enum": ["next-app-router", "unknown"] }
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } },
    "unknownPackages": { "type": "array", "items": { "type": "string" } },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "enum": ["pages-router", "no-app-router", "truncated", "parse-error"] },
          "message": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/fileNode" },
        { "$ref": "#/$defs/databaseNode" },
        { "$ref": "#/$defs/serviceNode" },
        { "$ref": "#/$defs/settingNode" }
      ]
    },
    "fileNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "role"],
      "properties": {
        "id": { "type": "string", "pattern": "^file:" },
        "kind": { "const": "file" },
        "path": { "type": "string" },
        "role": {
          "enum": [
            "page",
            "layout",
            "route",
            "middleware",
            "server-actions",
            "component",
            "module",
            "config"
          ]
        },
        "urlPath": { "type": "string" },
        "methods": {
          "type": "array",
          "items": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] }
        },
        "client": { "type": "boolean" }
      }
    },
    "databaseNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^database:" },
        "kind": { "const": "database" },
        "label": { "type": "string" },
        "via": { "type": "string" },
        "inferred": { "type": "boolean" }
      }
    },
    "serviceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^service:" },
        "kind": { "const": "service" },
        "label": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "settingNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "public"],
      "properties": {
        "id": { "type": "string", "pattern": "^setting:" },
        "kind": { "const": "setting" },
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "public": { "type": "boolean" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "label", "locations"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": {
          "enum": [
            "displays",
            "uses",
            "requests",
            "links",
            "reads",
            "writes",
            "connects",
            "uses-service",
            "reads-setting"
          ]
        },
        "label": { "type": "string" },
        "details": { "type": "array", "items": { "type": "string" } },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line", "role"],
            "properties": {
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "role": { "enum": ["import", "use"] },
              "code": { "type": "string", "maxLength": 160 }
            }
          }
        }
      }
    }
  }
}
