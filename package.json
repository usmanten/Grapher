{
  "name": "grapher-monorepo",
  "private": true,
  "description": "See how your Next.js project fits together.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b packages/cli && pnpm --filter @grapher/viewer build",
    "typecheck": "tsc -b packages/cli && tsc -p tsconfig.json && tsc -p packages/viewer",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "grapher": "node packages/cli/dist/index.js",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo coverage packages/viewer/test-results",
    "test:e2e": "pnpm --filter @grapher/viewer test:e2e",
    "test:secrets": "node scripts/check-secrets-fixture.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
